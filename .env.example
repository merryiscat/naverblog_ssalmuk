# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. (.env는 git에 올라가지 않음)
# 각 키의 발급 절차는 셋업 위저드(uv run setup)가 단계별로 안내한다.

# --- OpenAI (글 생성·판단·이미지) ---
OPENAI_API_KEY=

# --- 네이버 오픈API (검색·데이터랩) ---
# ※ 2026-08 기준 신규 발급 중단 — 과거에 발급받은 키가 있을 때만 채운다.
#   없으면 비워둬도 됨 (검색광고 API + 스크래핑으로 대체 동작).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 네이버 검색광고 API (월간 검색량 — searchad.naver.com) ---
SEARCHAD_API_KEY=
SEARCHAD_SECRET_KEY=
SEARCHAD_CUSTOMER_ID=

# --- 텔레그램 (일일 리포트·소환 알림) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 비밀 정보 — 절대 커밋 금지
.env

# 파이썬 가상환경·캐시
.venv/
__pycache__/
*.pyc

# 런타임 데이터 — DB, 네이버 로그인 세션, 생성된 글·이미지
# (세션 파일이 유출되면 계정이 탈취될 수 있으므로 반드시 제외)
data/

# Playwright MCP 브라우저 스냅샷 (세션 작업 부산물)
.playwright-mcp/

# .env 변형 파일도 차단 (.env.local 등) — 단, 키 없는 견본은 커밋 허용
.env.*
!.env.example

# OS 잡파일
Thumbs.db
Desktop.ini
.DS_Store
